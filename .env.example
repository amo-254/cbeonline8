# Neon/PostgreSQL pooled connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Generate with: openssl rand -base64 32
SESSION_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"

# Required for the scheduled January academic-year transition on Vercel
CRON_SECRET="REPLACE_WITH_A_LONG_RANDOM_CRON_SECRET"
